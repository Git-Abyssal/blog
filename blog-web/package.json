{
  "name": "blog-web",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "npm run dev:site",
    "dev:site": "vite --config vite.site.config.ts",
    "dev:admin": "vite --config vite.admin.config.ts",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.test.json",
    "build": "npm run typecheck && npm run build:site && npm run build:admin",
    "build:site": "vite build --config vite.site.config.ts",
    "build:admin": "vite build --config vite.admin.config.ts",
    "lint": "eslint .",
    "preview": "npm run preview:site",
    "preview:site": "vite preview --config vite.site.config.ts",
    "preview:admin": "vite preview --config vite.admin.config.ts",
    "test": "vitest --config vitest.config.ts",
    "test:ui": "vitest --ui --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.284.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.18.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.9",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^13.24.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript-eslint": "8.48.0",
    "typescript": "^5.2.2",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
