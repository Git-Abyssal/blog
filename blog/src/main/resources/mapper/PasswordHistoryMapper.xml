<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.blog.mapper.PasswordHistoryMapper">

    <select id="selectRecent" resultType="com.example.blog.entity.PasswordHistory">
        SELECT id, password_hash AS passwordHash, changed_at AS changedAt
        FROM password_history
        ORDER BY changed_at DESC
        LIMIT #{limit}
    </select>
</mapper>
