{
	admin off
	default_sni 43.142.151.167
}

{$SITE_ADDRESS} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	encode zstd gzip

	@legacyIp host 43.142.151.167
	redir @legacyIp https://abyssalnotes.com{uri} 308

	handle /files/api/* {
		uri strip_prefix /files
		reverse_proxy fileshare-backend:8080 {
			transport http {
				dial_timeout 10s
				response_header_timeout 30m
				read_timeout 30m
				write_timeout 30m
			}
		}
	}

	handle /files-objects/* {
		uri strip_prefix /files-objects
		reverse_proxy fileshare-minio:9000 {
			header_up Host minio:9000
			transport http {
				dial_timeout 10s
				response_header_timeout 30m
				read_timeout 30m
				write_timeout 30m
			}
			flush_interval -1
		}
	}

	@files path /files /files/*
	handle @files {
		reverse_proxy fileshare-frontend:3000
	}

	@resumeRoot path /resume
	redir @resumeRoot /resume/ 308

	handle /resume/* {
		reverse_proxy resume-frontend:8080
	}

	# 美甲本页面已迁到 helloabyssal.com；这里只保留 308 跳转，
	# 兜住可能还内置旧网址的已发布 App 版本。
	@nailbookLegacy path /privacy /privacy/ /support /support/ /nailbook/* /nailbook-assets/*
	redir @nailbookLegacy https://helloabyssal.com{uri} 308

	handle {
		reverse_proxy frontend:8080
	}
}

helloabyssal.com {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	encode zstd gzip

	@home path /
	redir @home /nailbook/support 308

	@nailbookPages path /privacy /privacy/ /support /support/ /nailbook/* /nailbook-assets/*
	handle @nailbookPages {
		reverse_proxy nailbook-site:80
	}

	handle {
		respond "Not Found" 404
	}
}
