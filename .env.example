# This template is safe to commit. Copy it to .env, fill in real values,
# and never commit the resulting .env file.

# Database Configuration
DB_ROOT_PASSWORD=your_secure_mysql_root_password_here
DB_USERNAME=blog_user
DB_PASSWORD=your_secure_mysql_password_here

# JWT Configuration - must be valid Base64. Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_the_generated_base64_value

# Initial owner password - change it after the first login.
BLOG_OWNER_INITIAL_PASSWORD=replace_with_strong_initial_owner_password
BLOG_OWNER_USERNAME=admin
BLOG_SITE_TITLE=Abyssal的分享
BLOG_AUTHOR_NAME=Abyssal
BLOG_SITE_DESCRIPTION=这里记录 Spring Boot、工程实践与产品构建。文章由我独立维护，访客留言审核后公开。

# Public site URL
APP_BASE_URL=https://your-domain.com
SITE_ADDRESS=your-domain.com

# Uploaded images are kept in a persistent Docker volume.
STORAGE_BUCKET=blog-images
STORAGE_PUBLIC_URL=/storage

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGIN_PATTERNS=https://your-domain.com

# Reverse proxy addresses trusted for X-Forwarded-For (Docker private network + localhost).
# Append the exact IP/CIDR of any outer HTTPS proxy or CDN; never use 0.0.0.0/0.
SECURITY_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
